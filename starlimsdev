# ============================================================
# 9. SmartBear TestComplete
#
# TestComplete cannot reliably be sourced through WinGet.
# Use corporate installer package.
# ============================================================

Write-Host ""
Write-Host "=================================================="
Write-Host "Processing : SmartBear TestComplete"
Write-Host "=================================================="


try {

    # --------------------------------------------------------
    # Detect installed version
    # --------------------------------------------------------

    $TCInstalled = @(

        Get-ItemProperty `
            "HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\*" `
            -ErrorAction SilentlyContinue

        Get-ItemProperty `
            "HKLM:\SOFTWARE\WOW6432Node\Microsoft\Windows\CurrentVersion\Uninstall\*" `
            -ErrorAction SilentlyContinue

    ) |
    Where-Object {

        $_.DisplayName -match "^TestComplete"
    } |
    Sort-Object DisplayVersion -Descending |
    Select-Object -First 1


    $NeedTestCompleteInstall = $true


    if ($TCInstalled) {

        Write-Host `
            "Installed TestComplete: $($TCInstalled.DisplayVersion)"


        try {

            $InstalledVersion = `
                [version]$TCInstalled.DisplayVersion


            if (
                $InstalledVersion -ge
                $TestCompleteTargetVersion
            ) {

                $NeedTestCompleteInstall = $false
            }
        }
        catch {
        }
    }


    # --------------------------------------------------------
    # Already current
    # --------------------------------------------------------

    if (-not $NeedTestCompleteInstall) {

        Write-Host `
            "[OK] TestComplete is already at or above baseline $TestCompleteTargetVersion."


        Add-Result `
            -Name "SmartBear TestComplete" `
            -Status "Success" `
            -Message "Already current: $($TCInstalled.DisplayVersion)"
    }


    # --------------------------------------------------------
    # Install / Update
    # --------------------------------------------------------

    if ($NeedTestCompleteInstall) {

        if (-not (Test-Path $TestCompleteInstaller)) {

            throw `
                "TestComplete installer not found: $TestCompleteInstaller"
        }


        Write-Host `
            "[INFO] Installing/upgrading TestComplete to baseline $TestCompleteTargetVersion..."


        $LogFolder = `
            Join-Path $WorkingRoot "TestCompleteLogs"


        New-Item `
            $LogFolder `
            -ItemType Directory `
            -Force |
            Out-Null


        $Arguments = @(

            "-SilentInstall"

            "-Log=$LogFolder"
        )


        $Arguments += `
            $TestCompleteExtraArguments


        $TCProcess = Start-Process `
            -FilePath $TestCompleteInstaller `
            -ArgumentList $Arguments `
            -Wait `
            -PassThru


        if (
            $TCProcess.ExitCode -notin @(0,3010)
        ) {

            throw `
                "TestComplete installer returned exit code $($TCProcess.ExitCode)"
        }


        Write-Host "[OK] TestComplete installation completed."


        Add-Result `
            -Name "SmartBear TestComplete" `
            -Status "Success" `
            -Message "Installed / upgraded"
    }
}
catch {

    $Message = $_.Exception.Message

    Write-Warning $Message


    Add-Result `
        -Name "SmartBear TestComplete" `
        -Status "Warning" `
        -Message $Message
}


