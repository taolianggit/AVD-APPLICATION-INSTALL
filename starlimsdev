# ============================================================
# Result helper
# ============================================================

function Add-Result {

    param(
        [string]$Name,
        [string]$Status,
        [string]$Message
    )

    $Results.Add(
        [PSCustomObject]@{
            Application = $Name
            Status      = $Status
            Message     = $Message
        }
    )
}


# ============================================================
# Find Winget
# ============================================================

function Get-WingetPath {

    $Command = Get-Command winget.exe -ErrorAction SilentlyContinue

    if ($Command) {
        return $Command.Source
    }


    $Package = Get-AppxPackage Microsoft.DesktopAppInstaller `
        -ErrorAction SilentlyContinue |
        Sort-Object Version -Descending |
        Select-Object -First 1

    if ($Package) {

        $Exe = Join-Path $Package.InstallLocation "winget.exe"

        if (Test-Path $Exe) {
            return $Exe
        }
    }


    $Package = Get-AppxPackage -AllUsers Microsoft.DesktopAppInstaller `
        -ErrorAction SilentlyContinue |
        Sort-Object Version -Descending |
        Select-Object -First 1

    if ($Package) {

        $Exe = Join-Path $Package.InstallLocation "winget.exe"

        if (Test-Path $Exe) {
            return $Exe
        }
    }


    $Candidate = Get-ChildItem `
        "C:\Program Files\WindowsApps\Microsoft.DesktopAppInstaller_*\winget.exe" `
        -ErrorAction SilentlyContinue |
        Sort-Object FullName -Descending |
        Select-Object -First 1


    if ($Candidate) {
        return $Candidate.FullName
    }


    return $null
}


# ============================================================
# Test Winget package installed
# ============================================================

function Test-WingetPackageInstalled {

    param(
        [string]$Id
    )

    try {

        $Output = & $Winget list `
            --id $Id `
            --exact `
            --accept-source-agreements `
            --disable-interactivity 2>&1


        return (
            $Output -match [regex]::Escape($Id)
        )
    }
    catch {

        return $false
    }
}


# ============================================================
# Test Winget update
# ============================================================

function Test-WingetUpgradeAvailable {

    param(
        [string]$Id
    )

    try {

        $Output = & $Winget list `
            --id $Id `
            --exact `
            --upgrade-available `
            --accept-source-agreements `
            --disable-interactivity 2>&1


        return (
            $Output -match [regex]::Escape($Id)
        )
    }
    catch {

        return $false
    }
}


# ============================================================
# Winget Install / Upgrade
# ============================================================

function InstallOrUpdate-WingetPackage {

    param(
        [Parameter(Mandatory)]
        [string]$Name,

        [Parameter(Mandatory)]
        [string]$Id,

        [string]$Architecture,

        [string]$Scope,

        [string]$InstallerType
    )


    Write-Host ""
    Write-Host "=================================================="
    Write-Host "Processing : $Name"
    Write-Host "Package ID : $Id"
    Write-Host "=================================================="


    try {

        # ----------------------------------------------------
        # Confirm package exists
        # ----------------------------------------------------

        $ShowArgs = @(
            "show"
            "--id", $Id
            "--exact"
            "--source", "winget"
            "--accept-source-agreements"
            "--disable-interactivity"
        )


        & $Winget @ShowArgs | Out-Null

        if ($LASTEXITCODE -ne 0) {

            throw "Package not found in WinGet repository."
        }


        # ----------------------------------------------------
        # Installed?
        # ----------------------------------------------------

        $Installed = Test-WingetPackageInstalled -Id $Id


        # ====================================================
        # INSTALL
        # ====================================================

        if (-not $Installed) {

            Write-Host "[INFO] Not installed. Installing..."


            $Args = @(
                "install"
                "--id", $Id
                "--exact"
                "--source", "winget"
                "--silent"
                "--disable-interactivity"
                "--accept-source-agreements"
                "--accept-package-agreements"
            )


            if ($Architecture) {

                $Args += @(
                    "--architecture",
                    $Architecture
                )
            }


            if ($Scope) {

                $Args += @(
                    "--scope",
                    $Scope
                )
            }


            if ($InstallerType) {

                $Args += @(
                    "--installer-type",
                    $InstallerType
                )
            }


            & $Winget @Args


            if ($LASTEXITCODE -ne 0) {

                throw "Install returned exit code $LASTEXITCODE"
            }


            Write-Host "[OK] Installed."


            Add-Result `
                -Name $Name `
                -Status "Success" `
                -Message "Installed"

            return
        }


        # ====================================================
        # ALREADY INSTALLED
        # ====================================================

        Write-Host "[INFO] Already installed."


        $UpgradeAvailable = `
            Test-WingetUpgradeAvailable -Id $Id


        if (-not $UpgradeAvailable) {

            Write-Host "[OK] Already up to date."


            Add-Result `
                -Name $Name `
                -Status "Success" `
                -Message "Already up to date"

            return
        }


        # ====================================================
        # UPGRADE
        # ====================================================

        Write-Host "[INFO] Update available. Upgrading..."


        $Args = @(
            "upgrade"
            "--id", $Id
            "--exact"
            "--source", "winget"
            "--silent"
            "--disable-interactivity"
            "--accept-source-agreements"
            "--accept-package-agreements"
        )


        if ($Architecture) {

            $Args += @(
                "--architecture",
                $Architecture
            )
        }


        if ($Scope) {

            $Args += @(
                "--scope",
                $Scope
            )
        }


        if ($InstallerType) {

            $Args += @(
                "--installer-type",
                $InstallerType
            )
        }


        & $Winget @Args


        if ($LASTEXITCODE -ne 0) {

            throw "Upgrade returned exit code $LASTEXITCODE"
        }


        Write-Host "[OK] Upgraded."


        Add-Result `
            -Name $Name `
            -Status "Success" `
            -Message "Upgraded"
    }
    catch {

        $Message = $_.Exception.Message

        Write-Warning "$Name failed: $Message"


        Add-Result `
            -Name $Name `
            -Status "Failed" `
            -Message $Message
    }
}


