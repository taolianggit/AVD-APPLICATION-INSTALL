# ============================================================
# AWS Elastic Beanstalk CLI - V2.2
#
# Strategy:
# 1. Ensure working directory exists
# 2. Install/update Python 3.11 machine-wide
# 3. Locate the real Python executable
# 4. Add Python + Scripts to Machine PATH
# 5. Verify/upgrade pip
# 6. Install/update virtualenv
# 7. Locate Git
# 8. Clone AWS official EB CLI setup repository
# 9. Install/update EB CLI under C:\ProgramData\AWS-EBCLI
# 10. Locate actual EB CLI executable/wrappers
# 11. Add EB CLI Scripts directory to Machine PATH
# 12. Verify eb --version
# ============================================================

Write-Host ""
Write-Host "=================================================="
Write-Host "Processing : AWS Elastic Beanstalk CLI"
Write-Host "=================================================="


try {

    # --------------------------------------------------------
    # 1. Ensure working directory exists
    # --------------------------------------------------------

    if (-not $WorkingRoot) {
        $WorkingRoot = "C:\Windows\Temp\AVD-DevTools"
    }

    if (-not (Test-Path $WorkingRoot)) {

        New-Item `
            -Path $WorkingRoot `
            -ItemType Directory `
            -Force |
            Out-Null
    }


    # --------------------------------------------------------
    # 2. Install / Update Python 3.11 machine-wide
    # --------------------------------------------------------

    InstallOrUpdate-WingetPackage `
        -Name "Python 3.11" `
        -Id "Python.Python.3.11" `
        -Architecture "x64" `
        -Scope "machine"


    # --------------------------------------------------------
    # 3. Locate REAL Python 3.11
    # --------------------------------------------------------

    Write-Host ""
    Write-Host "Locating Python 3.11..."


    $PythonCandidates = @(
        "C:\Program Files\Python311\python.exe"
    )


    $PythonCandidates += @(
        Get-ChildItem `
            "C:\Program Files\Python311*\python.exe" `
            -ErrorAction SilentlyContinue |
        Select-Object -ExpandProperty FullName
    )


    $PythonExe = $null


    foreach ($Candidate in ($PythonCandidates | Select-Object -Unique)) {

        if (-not $Candidate) {
            continue
        }

        if (-not (Test-Path $Candidate)) {
            continue
        }

        if ($Candidate -match "\\Microsoft\\WindowsApps\\") {
            continue
        }


        $OldEAP = $ErrorActionPreference
        $ErrorActionPreference = "Continue"

        try {

            $PythonOutput = & $Candidate --version 2>&1
            $PythonExit   = $LASTEXITCODE
        }
        finally {

            $ErrorActionPreference = $OldEAP
        }


        if (
            $PythonExit -eq 0 -and
            $PythonOutput -match '^Python 3\.11'
        ) {

            $PythonExe = $Candidate
            break
        }
    }


    if (-not $PythonExe) {

        throw "Python 3.11 was installed but a valid python.exe could not be located."
    }


    Write-Host "[OK] Python located:"
    Write-Host "     $PythonExe"


    $OldEAP = $ErrorActionPreference
    $ErrorActionPreference = "Continue"

    try {

        $PythonVersionOutput = & $PythonExe --version 2>&1
        $PythonExit = $LASTEXITCODE
    }
    finally {

        $ErrorActionPreference = $OldEAP
    }


    $PythonVersionOutput |
        ForEach-Object {
            Write-Host $_
        }


    if ($PythonExit -ne 0) {

        throw "Python verification failed."
    }


    # --------------------------------------------------------
    # 4. Add Python and Scripts to MACHINE PATH
    # --------------------------------------------------------

    $PythonRoot = Split-Path `
        $PythonExe `
        -Parent


    $PythonScripts = Join-Path `
        $PythonRoot `
        "Scripts"


    $MachinePath = `
        [Environment]::GetEnvironmentVariable(
            "Path",
            "Machine"
        )


    if (-not $MachinePath) {
        $MachinePath = ""
    }


    $MachinePathParts = @(
        $MachinePath -split ";" |
        Where-Object {
            $_ -and $_.Trim()
        }
    )


    if ($MachinePathParts -notcontains $PythonRoot) {

        $MachinePath = (
            $MachinePath.TrimEnd(";") +
            ";" +
            $PythonRoot
        )

        Write-Host "[OK] Added Python to machine PATH."
    }


    $MachinePathParts = @(
        $MachinePath -split ";" |
        Where-Object {
            $_ -and $_.Trim()
        }
    )


    if ($MachinePathParts -notcontains $PythonScripts) {

        $MachinePath = (
            $MachinePath.TrimEnd(";") +
            ";" +
            $PythonScripts
        )

        Write-Host "[OK] Added Python Scripts to machine PATH."
    }


    [Environment]::SetEnvironmentVariable(
        "Path",
        $MachinePath,
        "Machine"
    )


    # Refresh current process PATH

    $env:Path = (
        [Environment]::GetEnvironmentVariable(
            "Path",
            "Machine"
        )
    ) + ";" + (
        [Environment]::GetEnvironmentVariable(
            "Path",
            "User"
        )
    )


    # --------------------------------------------------------
    # 5. Verify pip
    # --------------------------------------------------------

    Write-Host ""
    Write-Host "Checking pip..."


    $OldEAP = $ErrorActionPreference
    $ErrorActionPreference = "Continue"

    try {

        $PipOutput = & $PythonExe `
            -m pip `
            --version 2>&1

        $PipExit = $LASTEXITCODE
    }
    finally {

        $ErrorActionPreference = $OldEAP
    }


    $PipOutput |
        ForEach-Object {
            Write-Host $_
        }


    # --------------------------------------------------------
    # pip missing -> ensurepip
    # --------------------------------------------------------

    if ($PipExit -ne 0) {

        Write-Host "[INFO] pip is not available. Running ensurepip..."


        $OldEAP = $ErrorActionPreference
        $ErrorActionPreference = "Continue"

        try {

            $EnsureOutput = & $PythonExe `
                -m ensurepip `
                --upgrade 2>&1

            $EnsureExit = $LASTEXITCODE
        }
        finally {

            $ErrorActionPreference = $OldEAP
        }


        $EnsureOutput |
            ForEach-Object {
                Write-Host $_
            }


        if ($EnsureExit -ne 0) {

            throw "ensurepip failed. Exit code: $EnsureExit"
        }
    }


    # --------------------------------------------------------
    # Upgrade pip
    # --------------------------------------------------------

    Write-Host ""
    Write-Host "Upgrading pip..."


    $OldEAP = $ErrorActionPreference
    $ErrorActionPreference = "Continue"

    try {

        $PipUpgradeOutput = & $PythonExe `
            -m pip install `
            --upgrade `
            pip 2>&1

        $PipUpgradeExit = $LASTEXITCODE
    }
    finally {

        $ErrorActionPreference = $OldEAP
    }


    $PipUpgradeOutput |
        ForEach-Object {
            Write-Host $_
        }


    if ($PipUpgradeExit -ne 0) {

        throw "pip upgrade failed. Exit code: $PipUpgradeExit"
    }


    Write-Host "[OK] pip is ready."


    # --------------------------------------------------------
    # 6. Install / Update virtualenv
    # --------------------------------------------------------

    Write-Host ""
    Write-Host "Installing/updating virtualenv..."


    $OldEAP = $ErrorActionPreference
    $ErrorActionPreference = "Continue"

    try {

        $VirtualenvOutput = & $PythonExe `
            -m pip install `
            --upgrade `
            virtualenv 2>&1

        $VirtualenvExit = $LASTEXITCODE
    }
    finally {

        $ErrorActionPreference = $OldEAP
    }


    $VirtualenvOutput |
        ForEach-Object {
            Write-Host $_
        }


    if ($VirtualenvExit -ne 0) {

        throw "virtualenv installation failed. Exit code: $VirtualenvExit"
    }


    Write-Host "[OK] virtualenv is ready."


    # --------------------------------------------------------
    # 7. Locate Git
    # --------------------------------------------------------

    Write-Host ""
    Write-Host "Locating Git..."


    $GitCandidates = @(
        "C:\Program Files\Git\cmd\git.exe",
        "C:\Program Files\Git\bin\git.exe"
    )


    $GitExe = $null


    foreach ($Candidate in $GitCandidates) {

        if (Test-Path $Candidate) {

            $GitExe = $Candidate
            break
        }
    }


    if (-not $GitExe) {

        $GitCommand = Get-Command git.exe `
            -ErrorAction SilentlyContinue


        if ($GitCommand) {

            $GitExe = $GitCommand.Source
        }
    }


    if (-not $GitExe) {

        throw "Git for Windows could not be located."
    }


    Write-Host "[OK] Git located:"
    Write-Host "     $GitExe"


    # --------------------------------------------------------
    # 8. Clone AWS official EB CLI setup repository
    # --------------------------------------------------------

    $EBRepo = Join-Path `
        $WorkingRoot `
        "aws-elastic-beanstalk-cli-setup"


    if (Test-Path $EBRepo) {

        Remove-Item `
            $EBRepo `
            -Recurse `
            -Force `
            -ErrorAction SilentlyContinue
    }


    Write-Host ""
    Write-Host "Downloading AWS EB CLI setup repository..."


    $OldEAP = $ErrorActionPreference
    $ErrorActionPreference = "Continue"

    try {

        $GitOutput = & $GitExe `
            clone `
            --depth 1 `
            "https://github.com/aws/aws-elastic-beanstalk-cli-setup.git" `
            $EBRepo 2>&1

        $GitExit = $LASTEXITCODE
    }
    finally {

        $ErrorActionPreference = $OldEAP
    }


    $GitOutput |
        ForEach-Object {
            Write-Host $_
        }


    if ($GitExit -ne 0) {

        throw "Unable to clone AWS EB CLI setup repository. Exit code: $GitExit"
    }


    # --------------------------------------------------------
    # 9. Install / Update AWS EB CLI
    # --------------------------------------------------------

    $EBInstaller = Join-Path `
        $EBRepo `
        "scripts\ebcli_installer.py"


    if (-not (Test-Path $EBInstaller)) {

        throw "AWS EB CLI installer script was not found."
    }


    $EBCLIInstallRoot = `
        "C:\ProgramData\AWS-EBCLI"


    Write-Host ""
    Write-Host "Installing/updating AWS EB CLI..."
    Write-Host "Target: $EBCLIInstallRoot"


    $OldEAP = $ErrorActionPreference
    $ErrorActionPreference = "Continue"

    try {

        $EBInstallOutput = & $PythonExe `
            $EBInstaller `
            --location $EBCLIInstallRoot `
            --python-installation $PythonExe `
            --quiet 2>&1

        $EBInstallExit = $LASTEXITCODE
    }
    finally {

        $ErrorActionPreference = $OldEAP
    }


    $EBInstallOutput |
        ForEach-Object {
            Write-Host $_
        }


    if ($EBInstallExit -ne 0) {

        throw "AWS EB CLI installer failed. Exit code: $EBInstallExit"
    }


    # --------------------------------------------------------
    # 10. Locate actual EB CLI executable / wrappers
    #
    # Expected structure:
    #
    # C:\ProgramData\AWS-EBCLI
    #   \.ebcli-virtual-env
    #       \Scripts
    #           eb.exe
    #       \executables
    #           eb.bat
    #           eb.ps1
    # --------------------------------------------------------

    Write-Host ""
    Write-Host "Locating AWS EB CLI executable..."


    $EBVirtualEnvRoot = `
        "$EBCLIInstallRoot\.ebcli-virtual-env"


    $EBScriptsPath = `
        "$EBVirtualEnvRoot\Scripts"


    $EBWrapperPath = `
        "$EBVirtualEnvRoot\executables"


    $EBCandidates = @(
        "$EBScriptsPath\eb.exe",
        "$EBWrapperPath\eb.bat",
        "$EBWrapperPath\eb.ps1",
        "$EBWrapperPath\eb.cmd"
    )


    $EBExePath = $null


    foreach ($Candidate in $EBCandidates) {

        if (Test-Path $Candidate) {

            $EBExePath = $Candidate
            break
        }
    }


    # Fallback recursive search

    if (-not $EBExePath) {

        $EBFound = Get-ChildItem `
            $EBCLIInstallRoot `
            -Recurse `
            -Force `
            -ErrorAction SilentlyContinue |
        Where-Object {
            $_.Name -in @(
                "eb.exe",
                "eb.bat",
                "eb.ps1",
                "eb.cmd"
            )
        } |
        Select-Object -First 1


        if ($EBFound) {

            $EBExePath = $EBFound.FullName
        }
    }


    if (-not $EBExePath) {

        throw "EB CLI installation finished but no eb executable was found under $EBCLIInstallRoot."
    }


    Write-Host "[OK] AWS EB CLI executable located:"
    Write-Host "     $EBExePath"


    # --------------------------------------------------------
    # 11. Add EB CLI Scripts directory to MACHINE PATH
    #
    # Prefer:
    # .ebcli-virtual-env\Scripts
    #
    # because it contains the actual eb.exe.
    # --------------------------------------------------------

    if (Test-Path $EBScriptsPath) {

        $EBPathForMachine = $EBScriptsPath
    }
    else {

        $EBPathForMachine = `
            Split-Path `
                $EBExePath `
                -Parent
    }


    $MachinePath = `
        [Environment]::GetEnvironmentVariable(
            "Path",
            "Machine"
        )


    if (-not $MachinePath) {
        $MachinePath = ""
    }


    $MachinePathParts = @(
        $MachinePath -split ";" |
        Where-Object {
            $_ -and $_.Trim()
        }
    )


    if ($MachinePathParts -notcontains $EBPathForMachine) {

        $MachinePath = (
            $MachinePath.TrimEnd(";") +
            ";" +
            $EBPathForMachine
        )


        [Environment]::SetEnvironmentVariable(
            "Path",
            $MachinePath,
            "Machine"
        )


        Write-Host "[OK] Added AWS EB CLI to machine PATH:"
        Write-Host "     $EBPathForMachine"
    }
    else {

        Write-Host "[OK] AWS EB CLI path already exists in machine PATH:"
        Write-Host "     $EBPathForMachine"
    }


    # Refresh current process PATH

    $env:Path = (
        [Environment]::GetEnvironmentVariable(
            "Path",
            "Machine"
        )
    ) + ";" + (
        [Environment]::GetEnvironmentVariable(
            "Path",
            "User"
        )
    )


    # --------------------------------------------------------
    # 12. Verify AWS EB CLI
    # --------------------------------------------------------

    Write-Host ""
    Write-Host "Verifying AWS EB CLI..."


    $OldEAP = $ErrorActionPreference
    $ErrorActionPreference = "Continue"

    try {

        if ($EBExePath -match '\.ps1$') {

            $EBVersionOutput = & powershell.exe `
                -NoProfile `
                -ExecutionPolicy Bypass `
                -File $EBExePath `
                --version 2>&1
        }
        else {

            $EBVersionOutput = & $EBExePath `
                --version 2>&1
        }


        $EBVersionExit = $LASTEXITCODE
    }
    finally {

        $ErrorActionPreference = $OldEAP
    }


    $EBVersionOutput |
        ForEach-Object {
            Write-Host $_
        }


    if ($EBVersionExit -ne 0) {

        throw "AWS EB CLI verification failed. Exit code: $EBVersionExit"
    }


    $EBVersion = `
        ($EBVersionOutput -join " ").Trim()


    Write-Host ""
    Write-Host "[OK] AWS EB CLI is ready."
    Write-Host "     $EBVersion"


    Add-Result `
        -Name "AWS EB CLI" `
        -Status "Success" `
        -Message $EBVersion
}
catch {

    $Message = $_.Exception.Message

    Write-Warning "AWS EB CLI failed: $Message"


    Add-Result `
        -Name "AWS EB CLI" `
        -Status "Failed" `
        -Message $Message
}


