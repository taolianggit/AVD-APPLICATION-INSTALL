            "HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\*" `
            -ErrorAction SilentlyContinue |
        Where-Object {
            $_.DisplayName -match "SourceTree"
        } |
        Select-Object -First 1


    if (-not (Test-Path $SourceTreeEnterpriseMsi)) {

        throw "SourceTree Enterprise MSI not found: $SourceTreeEnterpriseMsi"
    }


    # MSI installation is idempotent enough for Golden Image
    # maintenance and also refreshes/updates an older enterprise
    # installation when a newer MSI is supplied.

    Write-Host "[INFO] Installing/updating SourceTree Enterprise..."


    $MSIProcess = Start-Process `
        -FilePath "msiexec.exe" `
        -ArgumentList @(
            "/i"
            "`"$SourceTreeEnterpriseMsi`""
            "ACCEPTEULA=1"
            "ALLUSERS=1"
            "/qn"
            "/norestart"
        ) `
        -Wait `
        -PassThru


    if (
        $MSIProcess.ExitCode -notin @(0,3010,1641)
    ) {

        throw "MSI returned exit code $($MSIProcess.ExitCode)"
    }


    Add-Result `
        -Name "SourceTree Enterprise" `
        -Status "Success" `
        -Message "Installed / updated"

    Write-Host "[OK] SourceTree Enterprise installed/updated."
}
